# Những thứ KHÔNG được copy vào Docker image.
# Bỏ sót .env = secret bị leak vào image gửi lên registry.
# Bỏ sót .git = image phình to (toàn bộ lịch sử commit).

# Secret — QUAN TRỌNG NHẤT: không bao giờ để .env vào image
.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.eggs

# Virtual environment
.venv
venv

# Git
.git
.gitignore

# Dev tools
.pytest_cache
.coverage
htmlcov
*.log

# IDE
.vscode
.idea

# OS
.DS_Store
Thumbs.db

# Screenshots & docs không cần trong image
screenshots/
